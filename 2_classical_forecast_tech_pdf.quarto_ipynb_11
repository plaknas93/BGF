    "#| echo: true\n",
    "#| output: true\n",
    "#| label: lst-dgp-3\n",
    "#| lst-cap: Observed Data and Estimated Signal\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Generate fitted values\n",
    "\n",
    "x = np.linspace(\n",
    "    df[\"Study_Hours\"].min(),\n",
    "    df[\"Study_Hours\"].max(),\n",
    "    100\n",
    ")\n",
    "\n",
    "b0 = model.params[\"const\"]\n",
    "b1 = model.params[\"Study_Hours\"]\n",
    "\n",
    "y_hat = b0 + b1 * x\n",
    "\n",
    "# Create the plot\n",
    "\n",
    "plt.figure(figsize=(9, 5.5))\n",
    "\n",
    "plt.scatter(\n",
    "    df[\"Study_Hours\"],\n",
    "    df[\"Actual_Score\"],\n",
    "    s=80,\n",
    "    label=\"Observed data\"\n",
    ")\n",
    "\n",
    "plt.plot(\n",
    "    x,\n",
    "    y_hat,\n",
    "    linewidth=2.5,\n",
    "    label=\"Estimated signal\"\n",
    ")\n",
    "\n",
    "# Regression equation\n",
    "\n",
    "equation = f\"Score = {b0:.2f} + {b1:.2f} × Study Hours\"\n",
    "\n",
    "plt.text(\n",
    "    0.05,\n",
    "    0.93,\n",
    "    equation,\n",
    "    transform=plt.gca().transAxes,\n",
    "    fontsize=12,\n",
    "    bbox=dict(\n",
    "        boxstyle=\"round,pad=0.4\",\n",
    "        facecolor=\"white\",\n",
    "        edgecolor=\"gray\"\n",
    "    )\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Study Hours\", fontsize=12)\n",
    "plt.ylabel(\"Actual Score\", fontsize=12)\n",
    "plt.title(\n",
    "    \"Observed Scores and the Estimated Signal\",\n",
    "    fontsize=14,\n",
    "    pad=15\n",
    ")\n",
    "\n",
    "plt.grid(alpha=0.2)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
