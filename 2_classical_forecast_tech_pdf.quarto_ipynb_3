        "\n",
        "\\#| lst-cap: \"Data Display and Scatter Plot\"\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\\# Create the dataset\n",
        "\n",
        "df = pd.DataFrame({\n",
        "\n",
        "    \"Student\": range(1, 11),\n",
        "\n",
        "    \"Study_Hours\": [1.5, 2.0, 3.5, 4.0, 5.5,\n",
        "\n",
        "                    6.0, 7.5, 8.0, 9.5, 10.0],\n",
        "\n",
        "    \"Actual_Score\": [43, 47, 56, 59, 68,\n",
        "\n",
        "                     70, 78, 81, 87, 89]\n",
        "\n",
        "})\n",
        "\n",
        "\\# Display the data\n",
        "\n",
        "display(df)\n",
        "\n",
