   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data = pd.DataFrame({\n",
    "    \"Student\": range(1, 11),\n",
    "    \"Study_Hours\": [1.5, 2.0, 3.5, 4.0, 5.5,\n",
    "                    6.0, 7.5, 8.0, 9.5, 10.0],\n",
    "    \"Actual_Score\": [43, 47, 56, 59, 68,\n",
    "                     70, 78, 81, 87, 89]\n",
    "})\n",
    "\n",
    "data"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5cff364a",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## Visualizing the Observed Data"
   ]
  },
