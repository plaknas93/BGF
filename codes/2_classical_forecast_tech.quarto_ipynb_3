    "#| lst-cap: 'Linear Regression: Capturing the Signal'\n",
    "\n",
    "import statsmodels.api as sm\n",
    "\n",
    "# Define dependent and independent variables\n",
    "\n",
    "X = df[\"Study_Hours\"]\n",
    "y = df[\"Actual_Score\"]\n",
